# --- Primary AI provider: Meterless Nightshift (Meterless Runtime, OpenAI-compatible) ---
# Token: Nightshift app -> connect link (http://<host>:8088/connect#k=<key>) or <stateDir>/proxy-token.
# "rt-local" placeholder is rejected. Pick a Nemotron model id from GET <base>/models.
NIGHTSHIFT_API_KEY=
# NIGHTSHIFT_TOKEN_FILE=/path/to/proxy-token
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_MODEL=meterless/auto
NIGHTSHIFT_APP=trade-memory

# --- Fallback: Nebius Token Factory ---
# Nebius Token Factory (OpenAI-compatible). Leave blank for DRY_RUN demos.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Prefer 30B when available; Nano-9B is the safe default in config.py
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Zetaris REST (tunnel first: ssh -L 3000:127.0.0.1:3000 root@<zetaris-server>)
ZETARIS_URL=http://localhost:3000
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=
# Set to 1 to force the offline demo_data CSV fallback
ZETARIS_OFFLINE=0

# H-MEM (Meterless engine) store dir; default data/hmem
# HMEM_DIR=
# TRADE_MEMORY_DRY_RUN=1
# Optional second Nightshift lane if the primary fails (e.g. local WebLLM)
NIGHTSHIFT_FALLBACK_MODEL=webllm/Qwen2.5-3B-Instruct-q4f16_1-MLC
