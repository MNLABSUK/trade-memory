# Nebius Token Factory (OpenAI-compatible). Leave blank for DRY_RUN demos.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Prefer 30B when available; Nano-9B is the safe default in config.py
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Zetaris REST (tunnel first: ssh -L 3000:127.0.0.1:3000 root@<zetaris-server>)
ZETARIS_URL=http://localhost:3000
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=
# Set to 1 to force the offline demo_data CSV fallback
ZETARIS_OFFLINE=0
